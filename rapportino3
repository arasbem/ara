<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Generatore Verbale Fotografico</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
  *{box-sizing:border-box;}
  body{
    background:#eef1f4;
    font-family:'Inter', system-ui, sans-serif;
    margin:0;
    padding:20px;
    color:#182430;
    transition: background 0.3s, color 0.3s;
  }
  body.dark-mode{ background:#0d1117; color:#e6edf3; }
  body.dark-mode .panel{ background:#161b22; border-color:#30363d; }
  body.dark-mode .panel-title{ color:#58a6ff; }
  body.dark-mode .btn{ background:#21262d; border-color:#30363d; color:#e6edf3; }
  body.dark-mode .btn.primary{ background:#1f6feb; border-color:#1f6feb; color:#fff; }
  body.dark-mode .btn.primary:hover{background:#1158c7;}
  body.dark-mode .btn.danger{ background:#da3633; border-color:#da3633; color:#fff; }
  body.dark-mode .btn.danger:hover{background:#b62324;}
  body.dark-mode input[type=text], body.dark-mode input[type=date], body.dark-mode input[type=email]{
    background:#0d1117; border-color:#30363d; color:#e6edf3;
  }
  body.dark-mode input[type=text]:focus, body.dark-mode input[type=date]:focus, body.dark-mode input[type=email]:focus{
    border-color:#58a6ff; box-shadow:0 0 0 3px rgba(88,166,255,0.15);
  }
  body.dark-mode input[type=text]::placeholder, body.dark-mode input[type=email]::placeholder{ color:#8b949e; }
  body.dark-mode .tag{ background:#0d1f2d; border-color:#30363d; }
  body.dark-mode .empty-note{ border-color:#30363d; color:#8b949e; }
  body.dark-mode .thumb{ border-color:#30363d; background:#0d1117; }
  body.dark-mode .thumb .rm{ background:rgba(22,27,34,0.92); border-color:#30363d; color:#e6edf3; }
  body.dark-mode .thumb .rm:hover{ border-color:#da3633; color:#da3633; }
  body.dark-mode .tag .tag-name .val{ color:#58a6ff; }
  body.dark-mode .tag .tag-name .miss{ color:#f85149; }
  body.dark-mode .tag .tag-name .seg{ color:#8b949e; }
  body.dark-mode .tag .tag-name .custom{ color:#3fb950; }
  body.dark-mode .tag .tag-name .fixed{ color:#8b949e; }
  body.dark-mode .tag-label{ color:#58a6ff; }
  body.dark-mode .debug-info{ color:#8b949e; }
  body.dark-mode .status.ok{ color:#3fb950; }
  body.dark-mode .field label{ color:#8b949e; }
  body.dark-mode .header-logo .logo-text .brand{ color:#58a6ff; }
  body.dark-mode .header-logo .logo-text .subtitle{ color:#8b949e; }
  body.dark-mode .header-right{ color:#8b949e; }
  body.dark-mode .header-right b{ color:#58a6ff; }
  body.dark-mode .status.error{ color:#f85149; }
  body.dark-mode .radio-group label{ color:#e6edf3; }
  body.dark-mode .radio-group label .doc-type-hint{ color:#8b949e; }
  body.dark-mode .radio-group label .doc-desc{ color:#8b949e; font-weight:400; }
  body.dark-mode .field-label-with-example .example{ color:#8b949e; }
  body.dark-mode .crop-modal{ background:#161b22; }
  body.dark-mode .crop-header{ color:#58a6ff; }
  body.dark-mode .crop-header span{ color:#8b949e; }
  body.dark-mode .crop-hint{ color:#8b949e; }
  body.dark-mode .theme-toggle{ background:#21262d; border-color:#30363d; color:#8b949e; }
  body.dark-mode .theme-toggle:hover{ background:#30363d; }
  body.dark-mode footer{ color:#8b949e; }
  body.dark-mode .status{ color:#8b949e; }
  body.dark-mode .filename-row .field label span{ color:#8b949e !important; }
  body.dark-mode .radio-group input[type="radio"]{ accent-color:#58a6ff; }
  body.dark-mode .crop-enhance{ background:#0d1117; }
  body.dark-mode .preset-btn{ background:#21262d; color:#e6edf3; border-color:#30363d; }
  body.dark-mode .preset-btn.active{ background:#1f6feb; border-color:#1f6feb; }
  body.dark-mode .enhance-sliders label{ color:#8b949e; }

  .wrap{max-width:920px; margin:0 auto;}
  .panel{
    background:#fff; border:1px solid #dde3e9; border-radius:4px;
    padding:22px; margin-bottom:20px;
    transition: background 0.3s, border-color 0.3s;
  }
  .panel-title{
    font-weight:600; font-size:13px; text-transform:uppercase;
    letter-spacing:.06em; color:#003b70; margin:0 0 18px;
  }
  .btn{
    background:#f4f6f8; border:1px solid #dde3e9; padding:14px;
    border-radius:4px; cursor:pointer; font-weight:600; font-size:14px;
    display:inline-flex; align-items:center; gap:8px;
    transition: background 0.3s, border-color 0.3s, color 0.3s;
  }
  .btn.primary{ background:#00549e; color:#fff; border-color:#00549e; }
  .btn.primary:hover{background:#003b70;}
  .btn:focus-visible{outline:2px solid #00549e; outline-offset:2px;}
  .btn.primary:disabled{ background:#a9c2d8; cursor:not-allowed; }
  .btn.danger{ background:#e2001a; color:#fff; border-color:#e2001a; }
  .btn.danger:hover{background:#b80014;}
  .btn.danger:disabled{ background:#f0b4bc; cursor:not-allowed; }
  .capture-buttons{display:flex; gap:10px; margin-bottom:16px;}
  .capture-buttons .btn{flex:1; justify-content:center;}
  #cameraInput,#fileInput{display:none;}

  .thumbs{ display:grid; grid-template-columns:repeat(auto-fill, minmax(76px,1fr)); gap:8px; }
  .thumb{ position:relative; aspect-ratio:1; border:1px solid #dde3e9; border-radius:4px; overflow:hidden; background:#f4f6f8; }
  .thumb img{width:100%; height:100%; object-fit:cover;}
  .thumb .rm{
    position:absolute; top:2px; right:2px; width:20px; height:20px;
    background:rgba(255,255,255,0.92); border:1px solid #dde3e9; border-radius:2px;
    cursor:pointer; text-align:center; font-size:13px; line-height:18px;
  }
  .thumb .rm:hover{border-color:#e2001a; color:#e2001a;}
  .thumb .num{ position:absolute; bottom:2px; left:2px; font-size:9px; background:rgba(255,255,255,0.92); padding:1px 4px; border-radius:2px; }
  .thumb .crop-badge{ position:absolute; top:2px; left:2px; font-size:7px; background:rgba(0,84,158,0.85); color:#fff; padding:1px 4px; border-radius:2px; }
  .drop-zone.drag-over{ outline:2px dashed #00549e; outline-offset:2px; background:#e8f1fa; border-radius:4px; }
  .empty-note{ font-size:12px; color:#667384; padding:20px; text-align:center; border:1px dashed #dde3e9; border-radius:4px; }
  label{ display:block; font-size:11px; font-weight:600; text-transform:uppercase; color:#667384; margin-bottom:6px; }
  .field{margin-bottom:16px;}

  input[type=text], input[type=date], input[type=email]{
    width:100%; background:#f4f6f8; border:1px solid #dde3e9; border-radius:4px;
    font-size:14px; padding:11px 12px; outline:none;
    transition: background 0.3s, border-color 0.3s, color 0.3s;
  }
  input[type=text]:focus, input[type=date]:focus, input[type=email]:focus{
    border-color:#00549e; box-shadow:0 0 0 3px rgba(0,84,158,0.12);
  }
  input[type=text]::placeholder, input[type=email]::placeholder{ color:#8899aa; font-size:13px; font-weight:400; }

  .radio-group{ display:flex; gap:24px; margin-bottom:16px; flex-wrap:wrap; }
  .radio-group label{
    display:flex; align-items:center; gap:8px; font-size:13px; font-weight:600;
    text-transform:none; color:#182430; cursor:pointer;
  }
  .radio-group label .doc-desc{ font-weight:400; color:#667384; }
  .radio-group input[type="radio"]{ width:18px; height:18px; accent-color:#00549e; cursor:pointer; }
  .tag{
    margin-top:22px; border:1px solid #dde3e9; border-radius:4px; background:#e8f1fa;
    padding:14px 16px 14px 22px; position:relative;
    transition: background 0.3s, border-color 0.3s;
  }
  .tag::before{
    content:''; position:absolute; left:0; top:0; bottom:0; width:6px;
    background:repeating-linear-gradient(-45deg, #00549e 0 4px, #e2001a 4px 8px);
    border-radius:4px 0 0 4px;
  }
  .tag-label{
    font-size:10px; text-transform:uppercase; letter-spacing:.14em; color:#003b70;
    display:flex; justify-content:space-between; margin-bottom:8px;
  }
  .tag-name{ font-family:monospace; font-size:13px; word-break:break-all; line-height:1.6; }
  .tag-name .seg{color:#667384;}
  .tag-name .val{color:#003b70; font-weight:600;}
  .tag-name .miss{color:#e2001a;}
  .tag-name .custom{color:#1e8e5a; font-weight:600;}
  .tag-name .fixed{color:#667384;}
  .filename-row{ display:flex; gap:10px; align-items:center; margin-top:16px; flex-wrap:wrap; }
  .filename-row .field{flex:1; min-width:200px; margin-bottom:0;}
  .filename-row .btn{flex:0 0 auto; padding:11px 16px; font-size:12px;}

  .email-row{ display:flex; gap:10px; align-items:flex-end; margin-bottom:14px; flex-wrap:wrap; }
  .email-row .field{ flex:1; min-width:200px; margin-bottom:0; }
  .email-row .btn{ flex:0 0 auto; padding:11px 16px; font-size:13px; }

  .generate-row .btn#btnGenerate{width:100%;}
  .status{ margin-top:10px; font-size:12px; color:#667384; min-height:16px; }
  .status.ok{color:#1e8e5a;}
  .status.error{color:#d1293b;}
  footer{ max-width:920px; margin:14px auto 0; font-size:11px; color:#667384; text-align:center; }
  .debug-info{ font-size:10px; color:#667384; margin-top:5px; font-family:monospace; }

  .crop-overlay{
    display:none; position:fixed; inset:0; background:rgba(10,16,24,0.82);
    z-index:1000; align-items:center; justify-content:center; padding:16px;
  }
  .crop-modal{
    background:#fff; border-radius:6px; padding:16px; max-width:95vw; max-height:92vh;
    overflow-y:auto; display:flex; flex-direction:column; align-items:center;
    transition: background 0.3s;
  }
  .crop-header{
    width:100%; display:flex; justify-content:space-between; align-items:center;
    font-weight:600; font-size:13px; text-transform:uppercase; letter-spacing:.06em;
    color:#003b70; margin-bottom:12px;
  }
  .crop-header span{color:#667384; font-weight:500; text-transform:none; letter-spacing:0;}
  .crop-canvas-wrap{ touch-action:none; line-height:0; width:100%; display:flex; justify-content:center; }
  #cropCanvas{ touch-action:none; cursor:move; border:1px solid #dde3e9; max-width:100%; max-height:60vh; display:block; }
  .crop-hint{ font-size:11px; color:#667384; margin-top:10px; text-align:center; }

  .crop-enhance{
    width:100%; margin-top:10px; padding:10px; background:#f4f6f8;
    border-radius:4px; display:flex; flex-direction:column; gap:8px;
    transition: background 0.3s;
  }
  .enhance-presets{ display:flex; gap:6px; }
  .preset-btn{
    flex:1; padding:7px 10px; font-size:11px; border:1px solid #dde3e9;
    border-radius:4px; background:#fff; cursor:pointer; font-weight:600;
    color:#182430; transition: background 0.2s, color 0.2s;
  }
  .preset-btn.active{ background:#00549e; color:#fff; border-color:#00549e; }
  .enhance-sliders{ display:flex; flex-direction:column; gap:6px; }
  .enhance-sliders label{
    display:flex; align-items:center; gap:8px; font-size:11px; text-transform:none;
    font-weight:500; color:#667384; margin:0;
  }
  .enhance-sliders input[type="range"]{ flex:1; accent-color:#00549e; }

  .crop-actions{ display:flex; gap:8px; margin-top:14px; width:100%; flex-wrap:wrap; }
  .crop-actions .btn{flex:1 1 auto; justify-content:center; font-size:12px; padding:11px 10px; min-width:110px;}

  .header-logo { display:flex; align-items:center; gap:14px; }
  .header-logo .logo-img { height:40px; width:auto; flex-shrink:0; display:block; object-fit:contain; }
  .header-logo .logo-text { display:flex; flex-direction:column; }
  .header-logo .logo-text .brand { font-size:18px; font-weight:700; color:#00549e; letter-spacing:-0.3px; line-height:1.2; transition: color 0.3s; }
  .header-logo .logo-text .subtitle { font-size:12px; color:#667384; font-weight:400; transition: color 0.3s; }
  .header-right { font-family:monospace; font-size:11px; color:#667384; text-align:right; transition: color 0.3s; }
  .header-right b {color:#003b70; transition: color 0.3s;}

  .theme-toggle {
    display:flex; align-items:center; gap:8px; font-size:12px; color:#667384;
    cursor:pointer; margin-left:auto; padding:6px 12px; border-radius:20px;
    background:#f4f6f8; border:1px solid #dde3e9;
    transition: background 0.3s, border-color 0.3s, color 0.3s;
  }
  .theme-toggle:hover{ background:#e8edf4; }
  .theme-toggle .icon { font-size:16px; }
  .theme-toggle .label-text { font-weight:500; }

  .inline-fields { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .inline-fields .field{margin-bottom:0;}

  .doc-type-hint { font-size:12px; color:#667384; font-weight:400; margin-left:6px; }
  .field-label-with-example { display:flex; justify-content:space-between; align-items:center; }
  .field-label-with-example .example { font-size:11px; font-weight:400; color:#667384; text-transform:none; }
  .radio-group label .doc-desc { font-weight:400; color:#667384; }
  body.dark-mode .radio-group label .doc-desc { color:#8b949e; }

  /* ===== CAMERA MODAL ===== */
  .camera-overlay{
    display:none; position:fixed; inset:0; background:rgba(10,16,24,0.96);
    z-index:1001; align-items:center; justify-content:center; padding:12px;
  }
  .camera-overlay.active{ display:flex; }
  .camera-modal{
    background:#000; border-radius:8px; padding:12px;
    max-width:96vw; max-height:96vh;
    display:flex; flex-direction:column; gap:10px;
  }
  .camera-header{
    display:flex; justify-content:space-between; align-items:center;
    color:#fff; font-size:13px; font-weight:600;
    text-transform:uppercase; letter-spacing:0.06em;
  }
  .camera-video-wrap{ position:relative; display:inline-block; max-width:100%; }
  #cameraVideo{ display:block; max-width:100%; max-height:70vh; border-radius:4px; }
  .camera-overlay-canvas{
    position:absolute; top:0; left:0; width:100%; height:100%;
    pointer-events:none;
  }
  .camera-status{ color:#8b949e; font-size:12px; text-align:center; min-height:16px; }
  .camera-actions{ display:flex; gap:10px; }
  .camera-actions .btn{ flex:1; justify-content:center; }

  @media (max-width:600px) {
    .header-logo .logo-img {height:30px;}
    .header-logo .logo-text .brand {font-size:15px;}
    .header-logo .logo-text .subtitle {font-size:10px;}
    .header-right {font-size:10px;}
    .radio-group{gap:12px;}
    .radio-group label{font-size:12px;}
    .inline-fields{grid-template-columns:1fr;}
    #cropCanvas{max-height:45vh;}
  }
</style>
</head>
<body>
<div class="wrap">

  <div class="panel">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
      <div class="header-logo">
        <img src="https://upload.wikimedia.org/wikipedia/commons/e/eb/Dormakaba_logo_one_line_RGB_ff_%281%29.jpg" alt="Dormakaba Logo" class="logo-img" onerror="this.style.display='none'">
        <div class="logo-text"></div>
      </div>
      <div style="display:flex; align-items:center; gap:12px;">
        <div class="header-right">Powered by <b>Andrea Arabia</b></div>
        <button class="theme-toggle" id="themeToggle" aria-label="Attiva/disattiva modalità scura">
          <span class="icon" id="themeIcon">🌙</span>
          <span class="label-text" id="themeLabel">Notte</span>
        </button>
      </div>
    </div>
  </div>

  <!-- FOTO -->
  <div class="panel">
    <div class="panel-title">Foto verbale</div>
    <div class="capture-buttons">
      <button class="btn primary" id="btnCamera" type="button">📷 Scatta foto</button>
      <label class="btn" id="btnUpload">📤 Carica foto
        <input type="file" id="fileInput" accept="image/*" multiple>
      </label>
    </div>
    <input type="file" id="cameraInput" accept="image/*" capture="environment">
    <div id="thumbWrap" class="drop-zone"><div class="empty-note">Nessuna foto aggiunta<br><span style="font-size:11px;">(su PC puoi anche trascinare qui le immagini)</span></div></div>
    <div class="debug-info" id="debugInfo"></div>
  </div>

  <!-- DATI -->
  <div class="panel">
    <div class="panel-title">Dati intervento</div>

    <div class="radio-group">
      <label><input type="radio" name="docType" value="CO" checked> CO <span class="doc-type-hint">(Conferma d'Ordine)</span></label>
      <label><input type="radio" name="docType" value="ESC"> CM-ESC <span class="doc-desc">(Hardware/Software)</span></label>
      <label><input type="radio" name="docType" value="EAD"> CM-EAD <span class="doc-desc">(Lettori)</span></label>
      <label><input type="radio" name="docType" value="LGS"> CM-LGS <span class="doc-desc">(Maniglie alberghi)</span></label>
    </div>

    <div class="field">
      <div class="field-label-with-example">
        <label for="cliente">Cliente</label>
        <span class="example">es. ROSSI SPA</span>
      </div>
      <input type="text" id="cliente" placeholder="Inserisci il nome del cliente">
    </div>

    <div id="coFields">
      <div class="field">
        <div class="field-label-with-example">
          <label for="co">Numero ordine <span id="coLabelHint">(CO)</span></label>
          <span class="example" id="coExample">es. 1300123456</span>
        </div>
        <input type="text" id="co" placeholder="Inserisci il numero ordine">
      </div>
    </div>

    <div id="escEadLgsFields" style="display:none;">
      <div class="inline-fields">
        <div class="field">
          <div class="field-label-with-example">
            <label for="xxx">Numero xxx</label>
            <span class="example" id="xxxExample">es. 123</span>
          </div>
          <input type="text" id="xxx" placeholder="Inserisci il numero">
        </div>
        <div class="field">
          <div class="field-label-with-example">
            <label for="anno">Anno</label>
            <span class="example" id="annoExample">es. 2026</span>
          </div>
          <input type="text" id="anno" placeholder="Inserisci l'anno">
        </div>
      </div>
    </div>

    <div class="field">
      <div class="field-label-with-example">
        <label for="tecnico">Cognome tecnico</label>
        <span class="example">es. BIANCHI</span>
      </div>
      <input type="text" id="tecnico" placeholder="Inserisci il cognome del tecnico">
    </div>

    <div class="field">
      <div class="field-label-with-example">
        <label for="data">Data intervento</label>
        <span class="example">seleziona dal calendario</span>
      </div>
      <input type="date" id="data">
    </div>

    <div class="filename-row">
      <div class="field">
        <label for="filenameManual">Nome file PDF <span style="font-weight:400;text-transform:none;color:#667384;">(modifica liberamente)</span></label>
        <input type="text" id="filenameManual" placeholder="Generato automaticamente">
      </div>
    </div>

    <div class="tag">
      <div class="tag-label"><span>Anteprima nome file</span><span id="tagStatus">⏳ INCOMPLETO</span></div>
      <div class="tag-name" id="tagName">…</div>
    </div>
  </div>

  <!-- GENERA -->
  <div class="panel generate-row">
    <div class="email-row">
      <div class="field">
        <label for="emailInput">Invia via email <span style="font-weight:400;text-transform:none;color:#667384;">(opzionale)</span></label>
        <input type="email" id="emailInput" list="emailList" placeholder="es. tecnico@azienda.it" autocomplete="email">
        <datalist id="emailList"></datalist>
      </div>
      <button class="btn" id="btnSendEmail" type="button" disabled>✉️ Invia PDF</button>
    </div>
    <button class="btn danger" id="btnGenerate" disabled>📄 Genera PDF</button>
    <div class="status" id="status">✅ Pronto per iniziare</div>
  </div>

</div>

<footer>Elaborazione locale nel browser · nessuna foto viene caricata su server esterni</footer>

<!-- CROP MODAL -->
<div class="crop-overlay" id="cropOverlay">
  <div class="crop-modal">
    <div class="crop-header"><span>✂️ Ritaglia e migliora</span><span id="cropCounter"></span></div>
    <div class="crop-canvas-wrap">
      <canvas id="cropCanvas"></canvas>
    </div>
    <div class="crop-hint">Trascina gli angoli per ridimensionare, trascina dentro il riquadro per spostarlo</div>

    <div class="crop-enhance">
      <div class="enhance-presets">
        <button class="preset-btn active" data-preset="orig" type="button">Originale</button>
        <button class="preset-btn" data-preset="doc" type="button">Documento</button>
        <button class="preset-btn" data-preset="bw" type="button">B/N</button>
      </div>
      <div class="enhance-sliders">
        <label>Luminosità <input type="range" id="brightnessRange" min="0.5" max="2" step="0.05" value="1"></label>
        <label>Contrasto <input type="range" id="contrastRange" min="0.5" max="2.5" step="0.05" value="1"></label>
      </div>
    </div>

    <div class="crop-actions">
      <button class="btn danger" id="btnCropDiscard" type="button">🗑️ Scarta foto</button>
      <button class="btn" id="btnCropSkip" type="button">Usa intera</button>
      <button class="btn primary" id="btnCropConfirm" type="button">✓ Conferma</button>
    </div>
  </div>
</div>

<!-- CAMERA MODAL -->
<div class="camera-overlay" id="cameraOverlay">
  <div class="camera-modal">
    <div class="camera-header">
      <span>📷 Scatta foto</span>
      <button class="btn" id="btnCameraClose" type="button" style="padding:6px 12px; font-size:12px;">✕</button>
    </div>
    <div class="camera-video-wrap">
      <video id="cameraVideo" autoplay playsinline muted></video>
      <canvas id="cameraOverlayCanvas" class="camera-overlay-canvas"></canvas>
    </div>
    <div class="camera-status" id="cameraStatus">Inquadra il foglio...</div>
    <div class="camera-actions">
      <button class="btn" id="btnCameraCancel" type="button">Annulla</button>
      <button class="btn primary" id="btnCameraCapture" type="button">📸 Cattura</button>
    </div>
  </div>
</div>

<script>
(function(){
  // ============================================================
  // STATO
  // ============================================================
  const state = { images: [] };
  let isGenerating = false;
  let isCustomFilename = false;

  // ============================================================
  // DOM
  // ============================================================
  const $ = id => document.getElementById(id);
  const cliente = $('cliente');
  const co = $('co');
  const coLabelHint = $('coLabelHint');
  const coExample = $('coExample');
  const xxx = $('xxx');
  const anno = $('anno');
  const xxxExample = $('xxxExample');
  const annoExample = $('annoExample');
  const tecnico = $('tecnico');
  const data = $('data');
  const docTypeRadios = document.querySelectorAll('input[name="docType"]');
  const filenameManual = $('filenameManual');
  const tagName = $('tagName');
  const tagStatus = $('tagStatus');
  const thumbWrap = $('thumbWrap');
  const btnGenerate = $('btnGenerate');
  const btnSendEmail = $('btnSendEmail');
  const emailInput = $('emailInput');
  const emailList = $('emailList');
  const statusEl = $('status');
  const debugInfo = $('debugInfo');
  const btnUpload = $('btnUpload');
  const btnCamera = $('btnCamera');
  const cameraInput = $('cameraInput');
  const fileInput = $('fileInput');
  const themeToggle = $('themeToggle');
  const themeIcon = $('themeIcon');
  const themeLabel = $('themeLabel');
  const coFields = $('coFields');
  const escEadLgsFields = $('escEadLgsFields');

  // Modale ritaglio
  const cropOverlay = $('cropOverlay');
  const cropCanvas = $('cropCanvas');
  const cropCounter = $('cropCounter');
  const btnCropConfirm = $('btnCropConfirm');
  const btnCropSkip = $('btnCropSkip');
  const btnCropDiscard = $('btnCropDiscard');
  const brightnessRange = $('brightnessRange');
  const contrastRange = $('contrastRange');

  // Camera
  const cameraOverlay = $('cameraOverlay');
  const cameraVideo = $('cameraVideo');
  const cameraOverlayCanvas = $('cameraOverlayCanvas');
  const cameraStatus = $('cameraStatus');
  const btnCameraClose = $('btnCameraClose');
  const btnCameraCancel = $('btnCameraCancel');
  const btnCameraCapture = $('btnCameraCapture');

  // ============================================================
  // TEMA GIORNO/NOTTE
  // ============================================================
  let darkMode = false;
  function toggleTheme() {
    darkMode = !darkMode;
    document.body.classList.toggle('dark-mode', darkMode);
    themeIcon.textContent = darkMode ? '☀️' : '🌙';
    themeLabel.textContent = darkMode ? 'Giorno' : 'Notte';
    localStorage.setItem('verbaleDarkMode', darkMode ? 'dark' : 'light');
  }
  const savedTheme = localStorage.getItem('verbaleDarkMode');
  if (savedTheme === 'dark') {
    darkMode = true;
    document.body.classList.add('dark-mode');
    themeIcon.textContent = '☀️';
    themeLabel.textContent = 'Giorno';
  }
  themeToggle.addEventListener('click', toggleTheme);

  // ============================================================
  // DATA DEFAULT
  // ============================================================
  function todayStr() {
    const d = new Date();
    const pad = n => String(n).padStart(2,'0');
    return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
  }
  data.value = todayStr();

  // ============================================================
  // TIPO DOCUMENTO
  // ============================================================
  function updateDocTypeHints() {
    const docType = getDocType();
    if (docType === 'CO') {
      coFields.style.display = 'block';
      escEadLgsFields.style.display = 'none';
      coLabelHint.textContent = '(CO)';
      coExample.textContent = 'es. 1300123456';
      co.placeholder = 'Inserisci il numero ordine';
    } else {
      coFields.style.display = 'none';
      escEadLgsFields.style.display = 'block';
      if (docType === 'ESC') { xxxExample.textContent = 'es. 123'; }
      else if (docType === 'EAD') { xxxExample.textContent = 'es. 456'; }
      else { xxxExample.textContent = 'es. 789'; }
      annoExample.textContent = 'es. 2026';
      xxx.placeholder = `Inserisci il numero (${xxxExample.textContent.replace('es. ','')})`;
      anno.placeholder = "Inserisci l'anno (es. 2026)";
    }
  }
  docTypeRadios.forEach(r => r.addEventListener('change', function() {
    updateDocTypeHints();
    onDataChange();
  }));

  // ============================================================
  // MIGLIORAMENTO LEGGIBILITÀ
  // ============================================================
  let enhanceBrightness = 1;
  let enhanceContrast = 1;
  let enhanceGrayscale = false;

  function getEnhanceFilter() {
    return `brightness(${enhanceBrightness}) contrast(${enhanceContrast})${enhanceGrayscale ? ' grayscale(1)' : ''}`.trim();
  }

  function setPreset(name) {
    const btns = document.querySelectorAll('.preset-btn');
    btns.forEach(b => b.classList.toggle('active', b.dataset.preset === name));
    if (name === 'orig') {
      enhanceBrightness = 1; enhanceContrast = 1; enhanceGrayscale = false;
    } else if (name === 'doc') {
      enhanceBrightness = 1.12; enhanceContrast = 1.45; enhanceGrayscale = false;
    } else if (name === 'bw') {
      enhanceBrightness = 1.15; enhanceContrast = 1.9; enhanceGrayscale = true;
    }
    brightnessRange.value = enhanceBrightness;
    contrastRange.value = enhanceContrast;
    if (currentCropImage) drawCrop();
  }

  document.querySelectorAll('.preset-btn').forEach(b => {
    b.addEventListener('click', () => setPreset(b.dataset.preset));
  });

  brightnessRange.addEventListener('input', function() {
    enhanceBrightness = parseFloat(this.value);
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    if (currentCropImage) drawCrop();
  });
  contrastRange.addEventListener('input', function() {
    enhanceContrast = parseFloat(this.value);
    document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    if (currentCropImage) drawCrop();
  });

  // ============================================================
  // RITAGLIO
  // ============================================================
  function autoDetectRect(img) {
    return new Promise((resolve) => {
      try {
        const canvas = document.createElement('canvas');
        canvas.width = img.width;
        canvas.height = img.height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0);
        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const data = imageData.data;
        const w = canvas.width;
        const h = canvas.height;
        let minX = w, maxX = 0, minY = h, maxY = 0;
        const threshold = 25;
        for (let y = 0; y < h; y += 2) {
          for (let x = 0; x < w; x += 2) {
            const idx = (y * w + x) * 4;
            const gray = (data[idx] + data[idx + 1] + data[idx + 2]) / 3;
            if (gray < 255 - threshold) {
              if (x < minX) minX = x;
              if (x > maxX) maxX = x;
              if (y < minY) minY = y;
              if (y > maxY) maxY = y;
            }
          }
        }
        if (maxX === 0 && maxY === 0) { resolve({ x: 0, y: 0, w: w, h: h }); return; }
        const pad = 10;
        const x = Math.max(0, minX - pad);
        const y = Math.max(0, minY - pad);
        const cw = Math.min(w - x, maxX - minX + 1 + pad * 2);
        const ch = Math.min(h - y, maxY - minY + 1 + pad * 2);
        resolve({ x, y, w: cw, h: ch });
      } catch (e) {
        resolve({ x: 0, y: 0, w: img.width, h: img.height });
      }
    });
  }

  let currentCropImage = null;
  let cropRect = { x: 0, y: 0, w: 0, h: 0 };
  let dragMode = null;
  let dragStart = null;
  let cropRectStart = null;
  let cropResolve = null;
  const cropCtx2d = cropCanvas.getContext('2d');

  function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }

  function getCorners() {
    return [
      { x: cropRect.x, y: cropRect.y },
      { x: cropRect.x + cropRect.w, y: cropRect.y },
      { x: cropRect.x, y: cropRect.y + cropRect.h },
      { x: cropRect.x + cropRect.w, y: cropRect.y + cropRect.h }
    ];
  }

  function drawCrop() {
    cropCtx2d.clearRect(0, 0, cropCanvas.width, cropCanvas.height);
    // Applica il filtro di miglioramento
    cropCtx2d.filter = getEnhanceFilter();
    cropCtx2d.drawImage(currentCropImage, 0, 0, cropCanvas.width, cropCanvas.height);
    cropCtx2d.filter = 'none';

    cropCtx2d.fillStyle = 'rgba(0,0,0,0.55)';
    cropCtx2d.fillRect(0, 0, cropCanvas.width, cropRect.y);
    cropCtx2d.fillRect(0, cropRect.y + cropRect.h, cropCanvas.width, cropCanvas.height - (cropRect.y + cropRect.h));
    cropCtx2d.fillRect(0, cropRect.y, cropRect.x, cropRect.h);
    cropCtx2d.fillRect(cropRect.x + cropRect.w, cropRect.y, cropCanvas.width - (cropRect.x + cropRect.w), cropRect.h);

    cropCtx2d.strokeStyle = '#ffffff';
    cropCtx2d.lineWidth = 5;
    cropCtx2d.strokeRect(cropRect.x, cropRect.y, cropRect.w, cropRect.h);
    cropCtx2d.strokeStyle = '#00549e';
    cropCtx2d.lineWidth = 2.5;
    cropCtx2d.strokeRect(cropRect.x, cropRect.y, cropRect.w, cropRect.h);

    cropCtx2d.strokeStyle = 'rgba(255,255,255,0.7)';
    cropCtx2d.lineWidth = 1;
    for (let i = 1; i < 3; i++) {
      const gx = cropRect.x + (cropRect.w * i / 3);
      cropCtx2d.beginPath(); cropCtx2d.moveTo(gx, cropRect.y); cropCtx2d.lineTo(gx, cropRect.y + cropRect.h); cropCtx2d.stroke();
      const gy = cropRect.y + (cropRect.h * i / 3);
      cropCtx2d.beginPath(); cropCtx2d.moveTo(cropRect.x, gy); cropCtx2d.lineTo(cropRect.x + cropRect.w, gy); cropCtx2d.stroke();
    }

    const scale = getCanvasScale();
    const R = 11 * Math.max(scale.x, scale.y);
    getCorners().forEach(c => {
      cropCtx2d.beginPath();
      cropCtx2d.arc(c.x, c.y, R, 0, Math.PI * 2);
      cropCtx2d.fillStyle = '#ffffff';
      cropCtx2d.fill();
      cropCtx2d.lineWidth = 3;
      cropCtx2d.strokeStyle = '#00549e';
      cropCtx2d.stroke();
      cropCtx2d.beginPath();
      cropCtx2d.arc(c.x, c.y, R * 0.4, 0, Math.PI * 2);
      cropCtx2d.fillStyle = '#00549e';
      cropCtx2d.fill();
    });
  }

  function getCanvasScale() {
    const rect = cropCanvas.getBoundingClientRect();
    if (rect.width === 0 || rect.height === 0) return { x: 1, y: 1 };
    return { x: cropCanvas.width / rect.width, y: cropCanvas.height / rect.height };
  }

  function getPointerPos(e) {
    const rect = cropCanvas.getBoundingClientRect();
    const scale = getCanvasScale();
    return { x: (e.clientX - rect.left) * scale.x, y: (e.clientY - rect.top) * scale.y };
  }

  const HIT_SCREEN_PX = 26;
  function hitTestCorner(pos) {
    const scale = getCanvasScale();
    const corners = getCorners();
    for (let i = 0; i < 4; i++) {
      const hitX = HIT_SCREEN_PX * scale.x;
      const hitY = HIT_SCREEN_PX * scale.y;
      if (Math.abs(pos.x - corners[i].x) < hitX && Math.abs(pos.y - corners[i].y) < hitY) return i;
    }
    return -1;
  }
  function hitTestInside(pos) {
    return pos.x > cropRect.x && pos.x < cropRect.x + cropRect.w && pos.y > cropRect.y && pos.y < cropRect.y + cropRect.h;
  }

  cropCanvas.addEventListener('pointerdown', function(e) {
    e.preventDefault();
    cropCanvas.setPointerCapture(e.pointerId);
    const pos = getPointerPos(e);
    const corner = hitTestCorner(pos);
    if (corner >= 0) dragMode = 'corner' + corner;
    else if (hitTestInside(pos)) dragMode = 'move';
    else dragMode = null;
    dragStart = pos;
    cropRectStart = { ...cropRect };
  });

  cropCanvas.addEventListener('pointermove', function(e) {
    if (!dragMode) return;
    e.preventDefault();
    const pos = getPointerPos(e);
    const dx = pos.x - dragStart.x;
    const dy = pos.y - dragStart.y;
    const MIN = 30;

    if (dragMode === 'move') {
      cropRect.x = clamp(cropRectStart.x + dx, 0, cropCanvas.width - cropRectStart.w);
      cropRect.y = clamp(cropRectStart.y + dy, 0, cropCanvas.height - cropRectStart.h);
    } else {
      const idx = parseInt(dragMode.replace('corner', ''), 10);
      let { x, y, w, h } = cropRectStart;
      let x2 = x + w, y2 = y + h;
      if (idx === 0) { x = clamp(x + dx, 0, x2 - MIN); y = clamp(y + dy, 0, y2 - MIN); }
      if (idx === 1) { x2 = clamp(x2 + dx, x + MIN, cropCanvas.width); y = clamp(y + dy, 0, y2 - MIN); }
      if (idx === 2) { x = clamp(x + dx, 0, x2 - MIN); y2 = clamp(y2 + dy, y + MIN, cropCanvas.height); }
      if (idx === 3) { x2 = clamp(x2 + dx, x + MIN, cropCanvas.width); y2 = clamp(y2 + dy, y + MIN, cropCanvas.height); }
      cropRect = { x, y, w: x2 - x, h: y2 - y };
    }
    drawCrop();
  });

  function endDrag() { dragMode = null; }
  cropCanvas.addEventListener('pointerup', endDrag);
  cropCanvas.addEventListener('pointercancel', endDrag);

  function openCropModal(dataUrl, label) {
    return new Promise((resolve) => {
      const img = new Image();
      img.onload = function() {
        currentCropImage = img;

        const maxW = Math.min(800, window.innerWidth - 60);
        const maxH = Math.min(window.innerHeight * 0.55, 500);
        let scale = Math.min(maxW / img.width, maxH / img.height, 1.5);
        if (!isFinite(scale) || scale <= 0) scale = 1;

        cropCanvas.width = Math.round(img.width * scale);
        cropCanvas.height = Math.round(img.height * scale);
        cropCanvas.style.width = Math.min(cropCanvas.width, maxW) + 'px';
        cropCanvas.style.height = Math.min(cropCanvas.height, maxH) + 'px';

        cropCounter.textContent = label || '';

        autoDetectRect(img).then(rect => {
          cropRect = { x: rect.x * scale, y: rect.y * scale, w: rect.w * scale, h: rect.h * scale };
          drawCrop();
          cropOverlay.style.display = 'flex';
          cropResolve = resolve;
        });
      };
      img.src = dataUrl;
    });
  }

  function closeCropModal() {
    cropOverlay.style.display = 'none';
    currentCropImage = null;
  }

  btnCropConfirm.addEventListener('click', function() {
    const scaleX = currentCropImage.width / cropCanvas.width;
    const scaleY = currentCropImage.height / cropCanvas.height;
    const safety = 2;
    const rx = cropRect.x + safety;
    const ry = cropRect.y + safety;
    const rw = Math.max(4, cropRect.w - safety * 2);
    const rh = Math.max(4, cropRect.h - safety * 2);

    let nx = clamp(Math.round(rx * scaleX), 0, currentCropImage.width - 1);
    let ny = clamp(Math.round(ry * scaleY), 0, currentCropImage.height - 1);
    let nw = clamp(Math.round(rw * scaleX), 1, currentCropImage.width - nx);
    let nh = clamp(Math.round(rh * scaleY), 1, currentCropImage.height - ny);

    const outCanvas = document.createElement('canvas');
    outCanvas.width = nw;
    outCanvas.height = nh;
    const octx = outCanvas.getContext('2d');
    octx.filter = getEnhanceFilter();
    octx.drawImage(currentCropImage, nx, ny, nw, nh, 0, 0, nw, nh);
    octx.filter = 'none';

    const outDataUrl = outCanvas.toDataURL('image/jpeg', 0.92);
    const resolve = cropResolve;
    closeCropModal();
    if (resolve) resolve({ dataUrl: outDataUrl, cropped: true });
  });

  btnCropSkip.addEventListener('click', function() {
    // Applica comunque il filtro di miglioramento
    const outCanvas = document.createElement('canvas');
    outCanvas.width = currentCropImage.width;
    outCanvas.height = currentCropImage.height;
    const octx = outCanvas.getContext('2d');
    octx.filter = getEnhanceFilter();
    octx.drawImage(currentCropImage, 0, 0);
    octx.filter = 'none';
    const outDataUrl = outCanvas.toDataURL('image/jpeg', 0.92);
    const resolve = cropResolve;
    closeCropModal();
    if (resolve) resolve({ dataUrl: outDataUrl, cropped: false });
  });

  btnCropDiscard.addEventListener('click', function() {
    const resolve = cropResolve;
    closeCropModal();
    if (resolve) resolve(null);
  });

  // ============================================================
  // COMPRESSIONE
  // ============================================================
  function compressImage(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          let width = img.width, height = img.height;
          const MAX = 1600;
          if (width > MAX || height > MAX) {
            const scale = MAX / Math.max(width, height);
            width = Math.round(width * scale);
            height = Math.round(height * scale);
          }
          const canvas = document.createElement('canvas');
          canvas.width = width; canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, width, height);
          ctx.drawImage(img, 0, 0, width, height);
          resolve(canvas.toDataURL('image/jpeg', 0.85));
        };
        img.onerror = () => reject(new Error('Immagine non valida'));
        img.src = e.target.result;
      };
      reader.onerror = () => reject(new Error('Lettura file fallita'));
      reader.readAsDataURL(file);
    });
  }

  // ============================================================
  // HANDLE FILES
  // ============================================================
  function isImageFile(f) {
    if (f.type && f.type.startsWith('image/')) return true;
    return /\.(jpe?g|png|gif|bmp|webp|heic|heif|tiff?|svg)$/i.test(f.name || '');
  }

  async function handleFiles(fileList) {
    const files = Array.from(fileList).filter(isImageFile);
    if (files.length === 0) {
      statusEl.textContent = '⚠️ Nessun file immagine valido';
      statusEl.className = 'status error';
      return;
    }
    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      try {
        statusEl.textContent = `📷 Elaborazione: ${file.name}...`;
        statusEl.className = 'status';
        debugInfo.textContent = `🔄 Elaborazione: ${file.name}`;
        const compressed = await compressImage(file);
        const label = files.length > 1 ? `(${i + 1}/${files.length})` : '';
        const result = await openCropModal(compressed, label);
        if (result === null) {
          statusEl.textContent = `🗑️ ${file.name} scartata`;
          statusEl.className = 'status';
          continue;
        }
        state.images.push({
          id: Date.now() + '_' + Math.random().toString(36).substr(2, 6),
          dataUrl: result.dataUrl,
          isCropped: result.cropped
        });
        renderThumbs();
        refreshGenerateState();
        statusEl.textContent = `✅ ${file.name} aggiunta`;
        statusEl.className = 'status ok';
        debugInfo.textContent = `✅ Caricata: ${file.name}`;
      } catch (err) {
        statusEl.textContent = `❌ Errore: ${file.name}`;
        statusEl.className = 'status error';
        debugInfo.textContent = `❌ Errore: ${file.name} - ${err.message}`;
      }
    }
  }

  // ============================================================
  // CAMERA — LIVE PREVIEW + RILEVAMENTO BORDI
  // ============================================================
  let cameraStream = null;
  let detectionRAF = null;

  async function openCameraModal() {
    try {
      cameraStream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: { ideal: 'environment' }, width: { ideal: 1920 }, height: { ideal: 1080 } },
        audio: false
      });
      cameraVideo.srcObject = cameraStream;
      try { await cameraVideo.play(); } catch(e) {}
      cameraOverlay.classList.add('active');
      cameraStatus.textContent = 'Inquadra il foglio...';
      cameraStatus.style.color = '#8b949e';
      startLiveDetection();
    } catch (err) {
      // Fallback: input file nativo
      cameraInput.click();
    }
  }

  function closeCameraModal() {
    if (cameraStream) {
      cameraStream.getTracks().forEach(t => t.stop());
      cameraStream = null;
    }
    if (detectionRAF) {
      cancelAnimationFrame(detectionRAF);
      detectionRAF = null;
    }
    cameraVideo.srcObject = null;
    cameraOverlay.classList.remove('active');
  }

  function startLiveDetection() {
    const overlay = cameraOverlayCanvas;
    const ctx = overlay.getContext('2d');

    const workCanvas = document.createElement('canvas');
    const workCtx = workCanvas.getContext('2d');
    const WORK_MAX = 260;

    function loop() {
      if (!cameraStream) return;
      if (cameraVideo.videoWidth > 0) {
        // Match overlay to video
        const rect = cameraVideo.getBoundingClientRect();
        if (overlay.width !== Math.round(rect.width) || overlay.height !== Math.round(rect.height)) {
          overlay.width = Math.round(rect.width);
          overlay.height = Math.round(rect.height);
        }

        // Prepare work canvas with video aspect
        const vAspect = cameraVideo.videoWidth / cameraVideo.videoHeight;
        let ww, wh;
        if (vAspect > 1) { ww = WORK_MAX; wh = Math.round(WORK_MAX / vAspect); }
        else { wh = WORK_MAX; ww = Math.round(WORK_MAX * vAspect); }
        if (workCanvas.width !== ww || workCanvas.height !== wh) {
          workCanvas.width = ww; workCanvas.height = wh;
        }
        workCtx.drawImage(cameraVideo, 0, 0, ww, wh);

        const quad = detectDocumentQuad(workCtx, ww, wh);
        ctx.clearRect(0, 0, overlay.width, overlay.height);

        if (quad) {
          const sx = overlay.width / ww;
          const sy = overlay.height / wh;
          ctx.strokeStyle = '#3fb950';
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.moveTo(quad[0].x * sx, quad[0].y * sy);
          for (let i = 1; i < 4; i++) ctx.lineTo(quad[i].x * sx, quad[i].y * sy);
          ctx.closePath();
          ctx.stroke();

          ctx.fillStyle = '#3fb950';
          quad.forEach(p => {
            ctx.beginPath();
            ctx.arc(p.x * sx, p.y * sy, 6, 0, Math.PI * 2);
            ctx.fill();
          });

          if (cameraStatus.dataset.state !== 'ok') {
            cameraStatus.textContent = '✓ Foglio rilevato — pronto per scattare';
            cameraStatus.style.color = '#3fb950';
            cameraStatus.dataset.state = 'ok';
          }
        } else {
          if (cameraStatus.dataset.state !== 'search') {
            cameraStatus.textContent = 'Inquadra il foglio...';
            cameraStatus.style.color = '#8b949e';
            cameraStatus.dataset.state = 'search';
          }
        }
      }
      detectionRAF = requestAnimationFrame(loop);
    }
    loop();
  }

  // Rileva il quadrilatero del foglio usando i 4 punti estremi della zona luminosa
  function detectDocumentQuad(ctx, w, h) {
    try {
      const imgData = ctx.getImageData(0, 0, w, h);
      const data = imgData.data;
      const gray = new Uint8Array(w * h);
      let sum = 0;
      for (let i = 0; i < w * h; i++) {
        const g = (data[i*4] + data[i*4+1] + data[i*4+2]) / 3;
        gray[i] = g;
        sum += g;
      }
      const avg = sum / (w * h);
      const threshold = Math.max(avg * 1.05, avg + 18);

      let tl = null, tr = null, br = null, bl = null;
      let minSum = Infinity, maxSum = -Infinity, minDiff = Infinity, maxDiff = -Infinity;

      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          if (gray[y*w + x] > threshold) {
            const s = x + y;
            const d = x - y;
            if (s < minSum) { minSum = s; tl = { x, y }; }
            if (s > maxSum) { maxSum = s; br = { x, y }; }
            if (d > maxDiff) { maxDiff = d; tr = { x, y }; }
            if (d < minDiff) { minDiff = d; bl = { x, y }; }
          }
        }
      }

      if (!tl || !tr || !br || !bl) return null;

      const area = Math.abs(
        (tl.x * tr.y - tr.x * tl.y) +
        (tr.x * br.y - br.x * tr.y) +
        (br.x * bl.y - bl.x * br.y) +
        (bl.x * tl.y - tl.x * bl.y)
      ) / 2;

      if (area < w * h * 0.12) return null;

      return [tl, tr, br, bl];
    } catch (e) {
      return null;
    }
  }

  async function captureFromCamera() {
    if (!cameraVideo.videoWidth) return;

    // Cap dimensione per performance
    const MAX_CAPTURE = 2400;
    let cw = cameraVideo.videoWidth, ch = cameraVideo.videoHeight;
    if (cw > MAX_CAPTURE || ch > MAX_CAPTURE) {
      const s = MAX_CAPTURE / Math.max(cw, ch);
      cw = Math.round(cw * s);
      ch = Math.round(ch * s);
    }

    const canvas = document.createElement('canvas');
    canvas.width = cw; canvas.height = ch;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(cameraVideo, 0, 0, cw, ch);

    const quad = detectDocumentQuad(ctx, cw, ch);
    let dataUrl;
    let corrected = false;

    if (quad) {
      try {
        dataUrl = warpPerspectiveToCanvas(canvas, quad);
        corrected = true;
      } catch (e) {
        dataUrl = canvas.toDataURL('image/jpeg', 0.92);
      }
    } else {
      dataUrl = canvas.toDataURL('image/jpeg', 0.92);
    }

    closeCameraModal();

    // Passa al ritaglio/miglioramento
    const result = await openCropModal(dataUrl, '');
    if (result) {
      state.images.push({
        id: Date.now() + '_' + Math.random().toString(36).substr(2, 6),
        dataUrl: result.dataUrl,
        isCropped: corrected
      });
      renderThumbs();
      refreshGenerateState();
      statusEl.textContent = corrected ? '✅ Foto catturata e raddrizzata' : '✅ Foto catturata';
      statusEl.className = 'status ok';
      debugInfo.textContent = corrected ? '✅ Foto catturata · correzione prospettica applicata' : '✅ Foto catturata (nessun bordo rilevato)';
    }
  }

  // ============================================================
  // CORREZIONE PROSPETTICA (omografia)
  // ============================================================
  function warpPerspectiveToCanvas(srcCanvas, quad) {
    const [tl, tr, br, bl] = quad;

    const widthTop = Math.hypot(tr.x - tl.x, tr.y - tl.y);
    const widthBottom = Math.hypot(br.x - bl.x, br.y - bl.y);
    const heightLeft = Math.hypot(bl.x - tl.x, bl.y - tl.y);
    const heightRight = Math.hypot(br.x - tr.x, br.y - tr.y);

    let outW = Math.round(Math.max(widthTop, widthBottom));
    let outH = Math.round(Math.max(heightLeft, heightRight));

    if (outW < 20 || outH < 20) {
      return srcCanvas.toDataURL('image/jpeg', 0.92);
    }

    const MAX_OUT = 2200;
    if (outW > MAX_OUT || outH > MAX_OUT) {
      const s = MAX_OUT / Math.max(outW, outH);
      outW = Math.round(outW * s);
      outH = Math.round(outH * s);
    }

    const dst = [[0, 0], [outW, 0], [outW, outH], [0, outH]];
    const src = [[tl.x, tl.y], [tr.x, tr.y], [br.x, br.y], [bl.x, bl.y]];
    const H = getHomography(dst, src);

    const srcCtx = srcCanvas.getContext('2d');
    const srcData = srcCtx.getImageData(0, 0, srcCanvas.width, srcCanvas.height).data;
    const sw = srcCanvas.width, sh = srcCanvas.height;

    const outCanvas = document.createElement('canvas');
    outCanvas.width = outW; outCanvas.height = outH;
    const outCtx = outCanvas.getContext('2d');
    const outImg = outCtx.createImageData(outW, outH);
    const outData = outImg.data;

    for (let y = 0; y < outH; y++) {
      for (let x = 0; x < outW; x++) {
        const w = H[6]*x + H[7]*y + H[8];
        const sx = (H[0]*x + H[1]*y + H[2]) / w;
        const sy = (H[3]*x + H[4]*y + H[5]) / w;
        const idx = (y * outW + x) * 4;

        if (sx >= 0 && sx < sw - 1 && sy >= 0 && sy < sh - 1) {
          const x0 = Math.floor(sx), y0 = Math.floor(sy);
          const fx = sx - x0, fy = sy - y0;
          const i00 = (y0 * sw + x0) * 4;
          const i10 = (y0 * sw + x0 + 1) * 4;
          const i01 = ((y0 + 1) * sw + x0) * 4;
          const i11 = ((y0 + 1) * sw + x0 + 1) * 4;

          outData[idx]     = srcData[i00]     * (1-fx) * (1-fy) + srcData[i10]     * fx * (1-fy) + srcData[i01]     * (1-fx) * fy + srcData[i11]     * fx * fy;
          outData[idx + 1] = srcData[i00 + 1] * (1-fx) * (1-fy) + srcData[i10 + 1] * fx * (1-fy) + srcData[i01 + 1] * (1-fx) * fy + srcData[i11 + 1] * fx * fy;
          outData[idx + 2] = srcData[i00 + 2] * (1-fx) * (1-fy) + srcData[i10 + 2] * fx * (1-fy) + srcData[i01 + 2] * (1-fx) * fy + srcData[i11 + 2] * fx * fy;
          outData[idx + 3] = 255;
        } else {
          outData[idx] = 255; outData[idx + 1] = 255; outData[idx + 2] = 255; outData[idx + 3] = 255;
        }
      }
    }

    outCtx.putImageData(outImg, 0, 0);
    return outCanvas.toDataURL('image/jpeg', 0.92);
  }

  function getHomography(src, dst) {
    const A = [], b = [];
    for (let i = 0; i < 4; i++) {
      const [x, y] = src[i];
      const [u, v] = dst[i];
      A.push([x, y, 1, 0, 0, 0, -u*x, -u*y]);
      A.push([0, 0, 0, x, y, 1, -v*x, -v*y]);
      b.push(u, v);
    }
    const h = solveLinearSystem(A, b);
    return [h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7], 1];
  }

  function solveLinearSystem(A, b) {
    const n = b.length;
    const M = A.map((row, i) => [...row, b[i]]);
    for (let i = 0; i < n; i++) {
      let maxRow = i;
      for (let k = i + 1; k < n; k++) {
        if (Math.abs(M[k][i]) > Math.abs(M[maxRow][i])) maxRow = k;
      }
      [M[i], M[maxRow]] = [M[maxRow], M[i]];
      if (Math.abs(M[i][i]) < 1e-12) continue;
      const pivot = M[i][i];
      for (let j = i; j <= n; j++) M[i][j] /= pivot;
      for (let k = 0; k < n; k++) {
        if (k !== i) {
          const factor = M[k][i];
          for (let j = i; j <= n; j++) M[k][j] -= factor * M[i][j];
        }
      }
    }
    return M.map(row => row[n]);
  }

  // ============================================================
  // EVENTI CAMERA
  // ============================================================
  btnCamera.addEventListener('click', openCameraModal);
  btnCameraClose.addEventListener('click', closeCameraModal);
  btnCameraCancel.addEventListener('click', closeCameraModal);
  btnCameraCapture.addEventListener('click', captureFromCamera);

  cameraInput.addEventListener('change', function() {
    if (this.files && this.files.length > 0) handleFiles(this.files);
    this.value = '';
  });
  fileInput.addEventListener('change', function() {
    if (this.files && this.files.length > 0) handleFiles(this.files);
    this.value = '';
  });

  // ============================================================
  // DRAG & DROP
  // ============================================================
  ['dragenter', 'dragover'].forEach(evt => {
    thumbWrap.addEventListener(evt, function(e) {
      e.preventDefault(); e.stopPropagation();
      thumbWrap.classList.add('drag-over');
    });
  });
  ['dragleave', 'drop'].forEach(evt => {
    thumbWrap.addEventListener(evt, function(e) {
      e.preventDefault(); e.stopPropagation();
      thumbWrap.classList.remove('drag-over');
    });
  });
  thumbWrap.addEventListener('drop', function(e) {
    const files = e.dataTransfer && e.dataTransfer.files;
    if (files && files.length > 0) handleFiles(files);
  });

  // ============================================================
  // SANITIZZAZIONE
  // ============================================================
  function sanitize(str) {
    return (str || '').toUpperCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^A-Z0-9 ]+/g, '')
      .replace(/\s+/g, ' ').trim();
  }
  function sanitizeWithSlash(str) {
    return (str || '').toUpperCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^A-Z0-9\/\-]+/g, '').trim();
  }
  function formatDate(isoStr) {
    if (!isoStr) return null;
    const [y, m, d] = isoStr.split('-');
    return `${d}.${m}.${y}`;
  }
  function getDocType() {
    for (const r of docTypeRadios) if (r.checked) return r.value;
    return 'CO';
  }

  // ============================================================
  // NOME FILE
  // ============================================================
  function buildFilename() {
    const docType = getDocType();
    const c = sanitize(cliente.value);
    const t = sanitize(tecnico.value);
    const dOk = formatDate(data.value);
    let coVal = '', xxxVal = '', annoVal = '';

    if (docType === 'CO') { coVal = sanitize(co.value); }
    else { xxxVal = sanitizeWithSlash(xxx.value); annoVal = sanitizeWithSlash(anno.value); }

    const cValid = c.length > 0;
    const tValid = t.length > 0;
    const dValid = !!dOk;
    let coValid = false, xxxValid = false, annoValid = false;
    if (docType === 'CO') coValid = coVal.length > 0;
    else { xxxValid = xxxVal.length > 0; annoValid = annoVal.length > 0; }

    const allValid = cValid && tValid && dValid && (docType === 'CO' ? coValid : (xxxValid && annoValid));

    const spanFixed = v => `<span class="fixed">${v}</span>`;
    const spanVal = (v, valid, label) => valid
      ? `<span class="val">${v}</span>`
      : `<span class="miss">${label}</span>`;
    const US = '<span class="seg">_</span>';

    let html = '', newAuto = null;

    if (docType === 'CO') {
      html = spanFixed('VA') + US + spanVal(c, cValid, 'CLIENTE') + US +
             spanFixed('CO') + US + spanVal(coVal, coValid, 'xxx') + US +
             spanVal(t, tValid, 'TECNICO') + US + spanVal(dOk, dValid, 'DATA');
      newAuto = allValid ? `VA_${c}_CO_${coVal}_${t}_${dOk}.pdf` : null;
    } else {
      let mid;
      if (docType === 'ESC') mid = '-PAS/';
      else if (docType === 'EAD') mid = '/';
      else mid = '-H/';

      html = spanFixed('VM') + US + spanVal(c, cValid, 'CLIENTE') + US +
             spanFixed('c.m. ') + spanVal(xxxVal, xxxValid, 'xxx') +
             spanFixed(mid) + spanVal(annoVal, annoValid, 'anno') + US +
             spanVal(t, tValid, 'TECNICO') + US + spanVal(dOk, dValid, 'DATA');
      newAuto = allValid ? `VM_${c}_c.m. ${xxxVal}${mid}${annoVal}_${t}_${dOk}.pdf` : null;
    }
    html += '<span class="seg">.pdf</span>';

    if (!isCustomFilename) {
      filenameManual.value = newAuto || '';
    }

    const finalFilename = filenameManual.value.trim() || null;

    if (isCustomFilename && finalFilename) {
      tagName.innerHTML = `<span class="custom">${finalFilename}</span>`;
    } else {
      tagName.innerHTML = html;
    }

    tagStatus.textContent = finalFilename ? '✅ PRONTO' : '⏳ INCOMPLETO';
    tagStatus.style.color = finalFilename ? '#1e8e5a' : '#d1293b';

    return { filename: finalFilename, allValid };
  }

  function refreshGenerateState() {
    const { filename, allValid } = buildFilename();
    const hasPhotos = state.images.length > 0;
    const ready = !isGenerating && allValid && hasPhotos && !!filename;
    btnGenerate.disabled = !ready;
    btnSendEmail.disabled = !ready;
    return { filename, allValid, hasPhotos };
  }

  function onDataChange() { refreshGenerateState(); }

  [cliente, co, xxx, anno, tecnico, data].forEach(el => {
    el.addEventListener('input', onDataChange);
    el.addEventListener('change', onDataChange);
  });

  filenameManual.addEventListener('input', function() {
    isCustomFilename = true;
    refreshGenerateState();
  });
  filenameManual.addEventListener('blur', function() {
    if (this.value.trim() === '') { isCustomFilename = false; refreshGenerateState(); }
  });

  // ============================================================
  // EMAIL — salvataggio e invio
  // ============================================================
  const EMAIL_KEY = 'verbaleEmails';

  function loadEmails() {
    try {
      const saved = JSON.parse(localStorage.getItem(EMAIL_KEY) || '[]');
      emailList.innerHTML = saved.map(e => `<option value="${e}">`).join('');
      if (saved.length > 0 && !emailInput.value) emailInput.value = saved[0];
    } catch (e) {}
  }

  function saveEmail(email) {
    if (!email) return;
    try {
      const saved = JSON.parse(localStorage.getItem(EMAIL_KEY) || '[]');
      const filtered = saved.filter(e => e.toLowerCase() !== email.toLowerCase());
      filtered.unshift(email);
      localStorage.setItem(EMAIL_KEY, JSON.stringify(filtered.slice(0, 10)));
      loadEmails();
    } catch (e) {}
  }

  loadEmails();

  function isValidEmail(v) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
  }

  // ============================================================
  // GENERAZIONE PDF
  // ============================================================
  async function generatePdfBlob() {
    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
    const pageW = pdf.internal.pageSize.getWidth();
    const pageH = pdf.internal.pageSize.getHeight();
    const margin = 10;

    for (let i = 0; i < state.images.length; i++) {
      if (i > 0) pdf.addPage();
      const imgData = state.images[i].dataUrl;
      const dims = await new Promise((resolve) => {
        const img = new Image();
        img.onload = () => resolve({ w: img.width, h: img.height });
        img.src = imgData;
      });
      const maxW = pageW - margin * 2;
      const maxH = pageH - margin * 2;
      let w = maxW;
      let h = (dims.h / dims.w) * w;
      if (h > maxH) { h = maxH; w = (dims.w / dims.h) * h; }
      pdf.addImage(imgData, 'JPEG', (pageW - w)/2, (pageH - h)/2, w, h);
    }
    return pdf.output('blob');
  }

  function downloadBlob(blob, filename) {
    const blobUrl = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = blobUrl;
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    setTimeout(() => URL.revokeObjectURL(blobUrl), 3000);
  }

  function isIOSDevice() {
    return /iPad|iPhone|iPod/.test(navigator.userAgent) ||
           (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  }

  btnGenerate.addEventListener('click', async function() {
    if (isGenerating) return;
    const { filename, allValid } = buildFilename();
    if (!allValid) {
      statusEl.textContent = '⚠️ Compila tutti i campi'; statusEl.className = 'status error'; return;
    }
    if (state.images.length === 0) {
      statusEl.textContent = '⚠️ Aggiungi almeno una foto'; statusEl.className = 'status error'; return;
    }
    if (!filename) {
      statusEl.textContent = '⚠️ Nome file non valido'; statusEl.className = 'status error'; return;
    }
    if (emailInput.value.trim()) saveEmail(emailInput.value.trim());

    isGenerating = true; this.disabled = true;
    statusEl.textContent = '📄 Generazione PDF...'; statusEl.className = 'status';
    debugInfo.textContent = `📄 Generazione PDF: ${filename}`;

    try {
      const pdfBlob = await generatePdfBlob();

      // iOS: prova share sheet per nome file corretto
      if (isIOSDevice() && navigator.canShare) {
        try {
          const pdfFile = new File([pdfBlob], filename, { type: 'application/pdf' });
          if (navigator.canShare({ files: [pdfFile] })) {
            await navigator.share({ files: [pdfFile], title: filename });
            statusEl.textContent = `✅ PDF condiviso: ${filename}`;
            statusEl.className = 'status ok';
            debugInfo.textContent = `✅ Condiviso via foglio iOS: ${filename}`;
            return;
          }
        } catch (shareErr) {
          if (shareErr.name === 'AbortError') {
            statusEl.textContent = '↩️ Salvataggio annullato'; statusEl.className = 'status';
            return;
          }
        }
      }

      downloadBlob(pdfBlob, filename);
      statusEl.textContent = `✅ PDF scaricato: ${filename}`;
      statusEl.className = 'status ok';
      debugInfo.textContent = `✅ Download completato: ${filename}`;
    } catch (err) {
      statusEl.textContent = `❌ Errore: ${err.message}`;
      statusEl.className = 'status error';
    } finally {
      isGenerating = false;
      this.disabled = false;
      refreshGenerateState();
    }
  });

  // ============================================================
  // INVIO PDF VIA EMAIL
  // ============================================================
  btnSendEmail.addEventListener('click', async function() {
    if (isGenerating) return;
    const email = emailInput.value.trim();
    if (!email || !isValidEmail(email)) {
      statusEl.textContent = '⚠️ Inserisci un indirizzo email valido';
      statusEl.className = 'status error';
      emailInput.focus();
      return;
    }
    const { filename, allValid } = buildFilename();
    if (!allValid) {
      statusEl.textContent = '⚠️ Compila tutti i campi'; statusEl.className = 'status error'; return;
    }
    if (state.images.length === 0) {
      statusEl.textContent = '⚠️ Aggiungi almeno una foto'; statusEl.className = 'status error'; return;
    }
    if (!filename) {
      statusEl.textContent = '⚠️ Nome file non valido'; statusEl.className = 'status error'; return;
    }

    saveEmail(email);
    isGenerating = true; this.disabled = true;
    statusEl.textContent = '📧 Preparazione...'; statusEl.className = 'status';

    try {
      const pdfBlob = await generatePdfBlob();
      const pdfFile = new File([pdfBlob], filename, { type: 'application/pdf' });

      // 1) Prova Web Share API con file (mobile e Chrome desktop)
      if (navigator.canShare && navigator.canShare({ files: [pdfFile] })) {
        try {
          await navigator.share({
            files: [pdfFile],
            title: filename,
            text: `Rapportino ${filename}`
          });
          statusEl.textContent = `✅ PDF condiviso. Scegli l'app email e invia a ${email}`;
          statusEl.className = 'status ok';
          debugInfo.textContent = `✅ Condivisione via Web Share completata`;
          return;
        } catch (shareErr) {
          if (shareErr.name === 'AbortError') {
            statusEl.textContent = '↩️ Condivisione annullata'; statusEl.className = 'status';
            return;
          }
        }
      }

      // 2) Fallback: scarica il PDF e apri mailto:
      downloadBlob(pdfBlob, filename);
      const subject = encodeURIComponent(`Rapportino ${filename}`);
      const body = encodeURIComponent(
        `Buongiorno,\n\nin allegato il rapportino "${filename}".\n\n` +
        `(Il PDF è stato scaricato automaticamente: allega il file a questa email.)\n\n` +
        `Cordiali saluti.`
      );
      const mailto = `mailto:${encodeURIComponent(email)}?subject=${subject}&body=${body}`;
      window.location.href = mailto;

      statusEl.textContent = `✅ PDF scaricato + client email aperto. Allega il file e invia.`;
      statusEl.className = 'status ok';
      debugInfo.textContent = `✅ Fallback mailto: PDF scaricato come "${filename}"`;
    } catch (err) {
      statusEl.textContent = `❌ Errore: ${err.message}`;
      statusEl.className = 'status error';
    } finally {
      isGenerating = false;
      this.disabled = false;
      refreshGenerateState();
    }
  });

  // ============================================================
  // RENDER MINIATURE
  // ============================================================
  function renderThumbs() {
    if (state.images.length === 0) {
      thumbWrap.innerHTML = '<div class="empty-note">Nessuna foto aggiunta<br><span style="font-size:11px;">(su PC puoi anche trascinare qui le immagini)</span></div>';
      return;
    }
    let html = '<div class="thumbs">';
    state.images.forEach((img, i) => {
      html += `
        <div class="thumb">
          <img src="${img.dataUrl}" alt="foto ${i+1}">
          <span class="num">${i+1}</span>
          ${img.isCropped ? '<span class="crop-badge">✂️</span>' : ''}
          <span class="rm" data-id="${img.id}">&times;</span>
        </div>
      `;
    });
    html += '</div>';
    thumbWrap.innerHTML = html;

    thumbWrap.querySelectorAll('.rm').forEach(btn => {
      btn.addEventListener('click', function() {
        const id = this.getAttribute('data-id');
        state.images = state.images.filter(img => String(img.id) !== id);
        renderThumbs();
        refreshGenerateState();
        statusEl.textContent = '🗑️ Foto rimossa';
        statusEl.className = 'status';
      });
    });
  }

  // ============================================================
  // INIZIALIZZAZIONE
  // ============================================================
  updateDocTypeHints();
  onDataChange();
  statusEl.textContent = '✅ Pronto per iniziare';
  statusEl.className = 'status ok';
  debugInfo.textContent = '✅ Inizializzato. Scatta o carica una foto per iniziare.';

  // Reset enhancement alla chiusura completa del crop (opzionale: mantiene le impostazioni)
  // Le impostazioni vengono mantenute per la foto successiva (utile per più pagine).

})();
</script>
